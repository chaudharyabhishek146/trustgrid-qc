{
  "name": "trustgrid-qc",
  "version": "0.1.0",
  "private": true,
  "description": "TrustGrid QC - multimodal AI quality inspection at factory weighbridges",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "worker": "tsx watch src/worker/index.ts",
    "worker:prod": "tsx src/worker/index.ts",
    "db:setup": "tsx scripts/setup-db.ts",
    "test": "tsx --test src/lib/domain/validation.test.ts",
    "typecheck": "tsc --noEmit",
    "e2e": "tsx scripts/e2e.ts",
    "qa": "tsx qa/01-integrity.ts && tsx qa/02-security.ts && tsx qa/03-state.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "next": "^15.1.0",
    "pg": "^8.13.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
