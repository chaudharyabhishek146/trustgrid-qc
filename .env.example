# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trustgrid

# ─── Gemini ──────────────────────────────────────────────────────────────────
# MOCK_GEMINI=true runs the entire workflow with NO API key — reviewers can
# clone and run without credentials. Flip to false to hit the live API.
MOCK_GEMINI=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
PROMPT_VERSION=qc-biomass-v1

# ─── Storage (swappable adapter: "local" | "s3") ─────────────────────────────
# local -> resumable part uploads served by this app on disk. Zero infra.
# s3    -> real S3/MinIO multipart; bytes never touch the app tier.
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./storage_data
UPLOAD_SIGNING_SECRET=dev-only-change-me

S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=trustgrid-images
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# ─── Policy ──────────────────────────────────────────────────────────────────
UPLOAD_URL_TTL_SECONDS=900
MAX_IMAGE_BYTES=20971520
REVIEW_CONFIDENCE_THRESHOLD=0.70
WORKER_POLL_MS=1000
